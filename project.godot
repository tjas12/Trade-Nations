; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Trade Nations Reboot"
config/icon="res://assets/app_icon.svg"
config/description="Offline town building with housing, production, trade, and landscape touch controls."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
SocialManager="*res://scripts/autoload/social_manager.gd"
DataManager="*res://scripts/autoload/data_manager.gd"
TimeManager="*res://scripts/autoload/time_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
InventoryManager="*res://scripts/autoload/inventory_manager.gd"
EconomyManager="*res://scripts/autoload/economy_manager.gd"
WorkerManager="*res://scripts/autoload/worker_manager.gd"
CurrencyManager="*res://scripts/autoload/currency_manager.gd"
ProgressionManager="*res://scripts/autoload/progression_manager.gd"
TutorialManager="*res://scripts/autoload/tutorial_manager.gd"
Autosave="*res://scripts/autoload/autosave.gd"

[display]

window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

environment/defaults/default_clear_color=Color(0.25, 0.45, 0.25, 1)
